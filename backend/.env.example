PORT=4000
# --- Per-user LLM encryption ---
# AES-256-GCM key for the user_llm_settings.api_key_blob column is
# derived from this secret (domain-separated SHA-256). Falls back to
# JWT_SECRET in development; production must set either this OR a
# sufficiently-long JWT_SECRET.
LLM_SETTINGS_SECRET=

# --- Storage / DB / auth (unchanged) ---
DB_PATH=./data/claude-web.db
STORAGE_PATH=./storage/attachments
MAX_ATTACHMENT_SIZE_MB=10
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=admin12345
# Optional. Better WebSearch quality; without it DuckDuckGo is used (no key).
# BRAVE_SEARCH_API_KEY=
# Skills directory. Default $HOME/.enllm/skills. Anything stored here
# is exposed to the LLM via Skill_list / Skill_read tools and persists
# in the enllm-skills named volume.
ENLLM_SKILLS_DIR=

# --- Abort upstream streams that never complete (milliseconds). ---
LLM_STREAM_TIMEOUT_MS=120000
# Cap tool rounds so a confused model cannot hang a run.
LLM_MAX_TOOL_ROUNDS=12